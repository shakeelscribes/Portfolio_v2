# Local environment. Copy to `.env.local` and adjust; `.env*` is gitignored.

# Canonical origin for metadata, Open Graph, sitemap and robots.
# Optional: falls back to the free Vercel subdomain when unset.
# Set this in the Vercel dashboard (Project > Settings > Environment Variables)
# when moving to a custom domain, so no code change is needed.
NEXT_PUBLIC_SITE_URL=https://mohamedshakeel.vercel.app
